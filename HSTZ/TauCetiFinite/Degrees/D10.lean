def witness : Nat.Partition 10 where
  parts := [5,4,1]
  parts_pos := by decide
  parts_sum := rfl

theorem witness_rows : partitionRows witness = [5,4,1] := by
  change ([5,4,1] : Multiset ℕ).sort (· ≥ ·) = [5,4,1]
  rw [Multiset.coe_sort]
  exact List.mergeSort_eq_self _ (by simp)

theorem norm : evenNormNumerator witness = ((10 : ℕ).factorial : ℤ) := by
  have hr : checkIndexedRow table (partitionRows witness) classes refs13 = true := by
    rw [witness_rows]; exact row13_checked
  rw [← indexedNorm_eq_evenNorm (by decide) table table_checked classes classes_checked witness refs13 hr]
  exact norm_checked

theorem cover_residue (nu : Nat.Partition 10) :
    evenCoverNumerator witness nu % 1000000007 ≠ 0 := by
  have hr : checkIndexedRow table (partitionRows witness) classes refs13 = true := by
    rw [witness_rows]; exact row13_checked
  obtain ⟨refs, hp, he⟩ := targets_checked (partitionRows nu)
    (checkClasses_complete classes classes_checked nu)
  rw [← indexedCover_eq_evenCover (by decide) table table_checked classes classes_checked witness nu refs13 refs hr hp]
  exact he

