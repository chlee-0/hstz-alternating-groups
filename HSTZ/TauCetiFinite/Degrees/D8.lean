def witness : Nat.Partition 8 where
  parts := [4,3,1]
  parts_pos := by decide
  parts_sum := rfl

theorem witness_rows : partitionRows witness = [4,3,1] := by
  change ([4,3,1] : Multiset ℕ).sort (· ≥ ·) = [4,3,1]
  rw [Multiset.coe_sort]
  exact List.mergeSort_eq_self _ (by simp)

theorem norm : evenNormNumerator witness = ((8 : ℕ).factorial : ℤ) := by
  have hr : checkIndexedRow table (partitionRows witness) classes refs8 = true := by
    rw [witness_rows]; exact row8_checked
  rw [← indexedNorm_eq_evenNorm (by decide) table table_checked classes classes_checked witness refs8 hr]
  exact norm_checked

theorem cover_residue (nu : Nat.Partition 8) :
    evenCoverNumerator witness nu % 1000000007 ≠ 0 := by
  have hr : checkIndexedRow table (partitionRows witness) classes refs8 = true := by
    rw [witness_rows]; exact row8_checked
  obtain ⟨refs, hp, he⟩ := targets_checked (partitionRows nu)
    (checkClasses_complete classes classes_checked nu)
  rw [← indexedCover_eq_evenCover (by decide) table table_checked classes classes_checked witness nu refs8 refs hr hp]
  exact he

