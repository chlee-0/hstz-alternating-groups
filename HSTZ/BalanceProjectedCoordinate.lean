import HSTZ.IntertwiningCompat
import HSTZ.TensorInterfaces
import HSTZ.BalanceCoordinateLine
import HSTZ.SignSquareTransport
import HSTZ.SpechtTensorWords
import HSTZ.FilteredDual
import HSTZ.ProjectionLift
import HSTZ.PieriSupport
import OAI.RepresentationTheory.Saxl.CoordinateSector

/-! A retained pair coordinate in a concrete projected Specht square.
Adapts `UniversalSquare/Support/DualTransfer` and `ProjectedTensor` from
OpenAI's `math` repository (commit adc7f1241, Apache-2.0). The statements use the older vector API, a chosen sign map
and the concrete square in place of the newer generic `Equiv` bundles. -/
namespace HSTZ
noncomputable section
open OAI.Saxl
open scoped TensorProduct

private def coordinateSelfDualInverse {n : ℕ} {mu : YoungDiagram} (t : Tableau n mu) :
    Representation.IntertwiningMap (spechtRep t).dual (spechtRep t) where
  toLinearMap := (spechtSelfDualLinear t).symm.toLinearMap
  isIntertwining' g := by
    apply LinearMap.ext
    intro lam
    apply (spechtSelfDualLinear t).injective
    change spechtSelfDualLinear t ((spechtSelfDualLinear t).symm ((spechtRep t).dual g lam)) =
      spechtSelfDualLinear t (spechtRep t g ((spechtSelfDualLinear t).symm lam))
    rw [LinearEquiv.apply_symm_apply,spechtSelfDualLinear_equivariant,
      LinearEquiv.apply_symm_apply]

private def squareDualMap {n : ℕ} {mu : YoungDiagram} (t : Tableau n mu) :
    Representation.IntertwiningMap ((spechtRep t).dual.tprod (spechtRep t).dual)
      ((spechtRep t).tprod (spechtRep t)).dual where
  toLinearMap := (TensorProduct.dualDistribEquiv ℂ (Specht t) (Specht t)).toLinearMap
  isIntertwining' g := by
    apply LinearMap.ext
    intro v
    have heq : (TensorProduct.dualDistribEquiv ℂ (Specht t) (Specht t)).toLinearMap.comp
        (((spechtRep t).dual.tprod (spechtRep t).dual) g) =
      (((spechtRep t).tprod (spechtRep t)).dual g).comp
        (TensorProduct.dualDistribEquiv ℂ (Specht t) (Specht t)).toLinearMap := by
      ext l m x y
      rfl
    exact DFunLike.congr_fun heq v

private def squareDualInverse {n : ℕ} {mu : YoungDiagram} (t : Tableau n mu) :
    Representation.IntertwiningMap ((spechtRep t).tprod (spechtRep t)).dual
      ((spechtRep t).dual.tprod (spechtRep t).dual) where
  toLinearMap := (TensorProduct.dualDistribEquiv ℂ (Specht t) (Specht t)).symm.toLinearMap
  isIntertwining' g := by
    apply LinearMap.ext
    intro v
    apply (TensorProduct.dualDistribEquiv ℂ (Specht t) (Specht t)).injective
    change TensorProduct.dualDistribEquiv ℂ (Specht t) (Specht t)
      ((TensorProduct.dualDistribEquiv ℂ (Specht t) (Specht t)).symm
        (((spechtRep t).tprod (spechtRep t)).dual g v)) = _
    rw [LinearEquiv.apply_symm_apply]
    have he := (squareDualMap t).map_action g
      ((TensorProduct.dualDistribEquiv ℂ (Specht t) (Specht t)).symm v)
    change TensorProduct.dualDistribEquiv ℂ (Specht t) (Specht t)
      (((spechtRep t).dual.tprod (spechtRep t).dual) g
        ((TensorProduct.dualDistribEquiv ℂ (Specht t) (Specht t)).symm v)) =
      ((spechtRep t).tprod (spechtRep t)).dual g
        (TensorProduct.dualDistribEquiv ℂ (Specht t) (Specht t)
          ((TensorProduct.dualDistribEquiv ℂ (Specht t) (Specht t)).symm v)) at he
    rw [LinearEquiv.apply_symm_apply] at he
    exact he.symm

private def coordinateDualSign {n : ℕ} {mu : YoungDiagram} (t : Tableau n mu) :=
  (spechtSignMap t).comp (coordinateSelfDualInverse t)

private def nativeSquareMap {n : ℕ} {mu : YoungDiagram} (t : Tableau n mu) :=
  (wordTensorIntertwiner n (mu.colLen 0) (mu.colLen 0)).comp (spechtTensorInclusion t t)

/-- Both sign maps cancel; the codomain still retains every encoded pair letter. -/
def balanceDualSignMap {n : ℕ} {mu : YoungDiagram} (t : Tableau n mu) :
    Representation.IntertwiningMap ((spechtRep t).tprod (spechtRep t)).dual
      (wordRep n (mu.transpose.colLen 0 * mu.transpose.colLen 0)) :=
  (nativeSquareMap (transposeTableau t)).comp
    ((signSquareMap (coordinateDualSign t)).comp (squareDualInverse t))

private def squareCoordinateProjection {n : ℕ} {mu : YoungDiagram} (t : Tableau n mu)
    (P : (Fin n → Fin (mu.colLen 0 * mu.colLen 0)) → Prop)
    (hP : ∀ (g : Equiv.Perm (Fin n)) w, P (w ∘ g) ↔ P w) :
    Representation.IntertwiningMap (wordRep n (mu.colLen 0 * mu.colLen 0))
      (wordRep n (mu.colLen 0 * mu.colLen 0)) where
  toLinearMap := coordinateProjection P
  isIntertwining' g := by
    apply LinearMap.ext
    intro x
    classical
    funext w
    change (if P w then x (w ∘ g) else 0) = (if P (w ∘ g) then x (w ∘ g) else 0)
    rw [hP]

/-- Range of a coordinate filter on the full diagonal Specht square (not the cyclic
subspace generated by the repeated polytabloid). -/
def balanceProjectedSquare {n : ℕ} {mu : YoungDiagram} (t : Tableau n mu)
    (P : (Fin n → Fin (mu.colLen 0 * mu.colLen 0)) → Prop)
    (hP : ∀ (g : Equiv.Perm (Fin n)) w, P (w ∘ g) ↔ P w) :
    Subrepresentation (wordRep n (mu.colLen 0 * mu.colLen 0)) where
  toSubmodule := ((squareCoordinateProjection t P hP).comp (nativeSquareMap t)).toLinearMap.range
  apply_mem_toSubmodule g x hx := by
    obtain ⟨y,rfl⟩ := hx
    exact ⟨((spechtRep t).tprod (spechtRep t)) g y,
      ((squareCoordinateProjection t P hP).comp (nativeSquareMap t)).map_action g y⟩

private def squareProjectedQuotient {n : ℕ} {mu : YoungDiagram} (t : Tableau n mu)
    (P : (Fin n → Fin (mu.colLen 0 * mu.colLen 0)) → Prop)
    (hP : ∀ (g : Equiv.Perm (Fin n)) w, P (w ∘ g) ↔ P w) :
    Representation.IntertwiningMap ((spechtRep t).tprod (spechtRep t))
      (balanceProjectedSquare t P hP).toRepresentation where
  toLinearMap := ((squareCoordinateProjection t P hP).comp (nativeSquareMap t)).toLinearMap.rangeRestrict
  isIntertwining' g := by
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    exact ((squareCoordinateProjection t P hP).comp (nativeSquareMap t)).map_action g x

private def squareProjectedEvaluation {n : ℕ} {mu : YoungDiagram} (t : Tableau n mu)
    (P : (Fin n → Fin (mu.colLen 0 * mu.colLen 0)) → Prop)
    (hP : ∀ (g : Equiv.Perm (Fin n)) w, P (w ∘ g) ↔ P w)
    (w : Fin n → Fin (mu.colLen 0 * mu.colLen 0)) :
    Module.Dual ℂ (balanceProjectedSquare t P hP).toSubmodule where
  toFun x := x.val w
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- Pullback of the same surviving pair coordinate. -/
theorem balanceProjected_coordinate_pullback {n : ℕ} {mu : YoungDiagram}
    (t : Tableau n mu) (P : (Fin n → Fin (mu.colLen 0 * mu.colLen 0)) → Prop)
    (hP : ∀ (g : Equiv.Perm (Fin n)) w, P (w ∘ g) ↔ P w)
    (a b : Fin n → Fin (mu.colLen 0)) (hp : P (mergeWords a b)) :
    dualIntertwiner (squareProjectedQuotient t P hP)
      (squareProjectedEvaluation t P hP (mergeWords a b)) =
      TensorProduct.dualDistribEquiv ℂ (Specht t) (Specht t)
        (coordinateRestriction t a ⊗ₜ[ℂ] coordinateRestriction t b) := by
  classical
  ext x y
  change coordinateProjection P (nativeSquareMap t (x ⊗ₜ[ℂ] y)) (mergeWords a b) =
    y.val b * x.val a
  rw [coordinateProjection_apply,if_pos hp]
  change wordTensor _ _ _ (x.val ⊗ₜ[ℂ] y.val) (mergeWords a b) = _
  simp only [wordTensor_tmul,splitLeft_merge,splitRight_merge,mul_comm]

/-- The dual sign map sends a product of two coordinate restrictions to a nonzero
multiple of the tensor of the two transposed polytabloids. -/
theorem balanceDualSignMap_coordinates {n : ℕ} {mu : YoungDiagram}
    (t s u : Tableau n mu) :
    ∃ c : ℂ, c ≠ 0 ∧ balanceDualSignMap t
      (TensorProduct.dualDistribEquiv ℂ (Specht t) (Specht t)
        (coordinateRestriction t (rowWord s) ⊗ₜ[ℂ] coordinateRestriction t (rowWord u))) =
      c • wordTensor _ _ _ (polytabloid (transposeTableau s) ⊗ₜ[ℂ]
        polytabloid (transposeTableau u)) := by
  obtain ⟨c,hc,he⟩ := signEquiv_coordinate_line t s
  obtain ⟨d,hd,hf⟩ := signEquiv_coordinate_line t u
  refine ⟨c*d,mul_ne_zero hc hd,?_⟩
  change nativeSquareMap (transposeTableau t)
    (signSquareMap (coordinateDualSign t)
      ((TensorProduct.dualDistribEquiv ℂ (Specht t) (Specht t)).symm
        (TensorProduct.dualDistribEquiv ℂ (Specht t) (Specht t)
          (coordinateRestriction t (rowWord s) ⊗ₜ[ℂ] coordinateRestriction t (rowWord u))))) = _
  rw [LinearEquiv.symm_apply_apply,signSquareMap_tmul]
  change wordTensor _ _ _
    (((spechtSignMap t) (projectedCoordinate t (rowWord s))).val ⊗ₜ[ℂ]
      ((spechtSignMap t) (projectedCoordinate t (rowWord u))).val) = _
  rw [he,hf,TensorProduct.smul_tmul_smul,map_smul]

/-- Concrete dual-to-transposed-pair map for the filtered square. -/
def balanceProjectedDualMap {n : ℕ} {mu : YoungDiagram} (t : Tableau n mu)
    (P : (Fin n → Fin (mu.colLen 0 * mu.colLen 0)) → Prop)
    (hP : ∀ (g : Equiv.Perm (Fin n)) w, P (w ∘ g) ↔ P w) :=
  (balanceDualSignMap t).comp (dualIntertwiner (squareProjectedQuotient t P hP))

private def balanceProjectedDualRange {n : ℕ} {mu : YoungDiagram} (t : Tableau n mu)
    (P : (Fin n → Fin (mu.colLen 0 * mu.colLen 0)) → Prop)
    (hP : ∀ (g : Equiv.Perm (Fin n)) w, P (w ∘ g) ↔ P w) :
    Subrepresentation (wordRep n (mu.transpose.colLen 0 * mu.transpose.colLen 0)) where
  toSubmodule := (balanceProjectedDualMap t P hP).toLinearMap.range
  apply_mem_toSubmodule g x hx := by
    obtain ⟨y,rfl⟩ := hx
    exact ⟨(balanceProjectedSquare t P hP).toRepresentation.dual g y,
      (balanceProjectedDualMap t P hP).map_action g y⟩

/-- The entire prescribed pair cyclic space lies in the image of the dual of the filtered
square. The local selector and path placement still have to be specialized. -/
theorem balanceProjected_pair_cyclic_le_range {n : ℕ} {mu : YoungDiagram}
    (t s u : Tableau n mu) (P : (Fin n → Fin (mu.colLen 0 * mu.colLen 0)) → Prop)
    (hP : ∀ (g : Equiv.Perm (Fin n)) w, P (w ∘ g) ↔ P w)
    (hp : P (mergeWords (rowWord s) (rowWord u))) :
    cyclic (wordRep n (mu.transpose.colLen 0 * mu.transpose.colLen 0))
      (wordTensor _ _ _ (polytabloid (transposeTableau s) ⊗ₜ[ℂ] polytabloid (transposeTableau u))) ≤
      balanceProjectedDualRange t P hP := by
  obtain ⟨c,hc,he⟩ := balanceDualSignMap_coordinates t s u
  apply (cyclic_le _ _ _).mpr
  apply (Submodule.smul_mem_iff _ hc).mp
  refine ⟨squareProjectedEvaluation t P hP (mergeWords (rowWord s) (rowWord u)),?_⟩
  change balanceDualSignMap t (dualIntertwiner (squareProjectedQuotient t P hP)
    (squareProjectedEvaluation t P hP (mergeWords (rowWord s) (rowWord u)))) = _
  rw [balanceProjected_coordinate_pullback t P hP _ _ hp]
  exact he

private def projectedSpechtFlip {n : ℕ} {mu nu : YoungDiagram}
    (t : Tableau n mu) (v : Tableau n nu)
    (P : (Fin n → Fin (mu.colLen 0 * mu.colLen 0)) → Prop)
    (hP : ∀ (g : Equiv.Perm (Fin n)) w, P (w ∘ g) ↔ P w)
    (F : Representation.IntertwiningMap (spechtRep v)
      (balanceProjectedSquare t P hP).toRepresentation.dual) :
    Representation.IntertwiningMap (balanceProjectedSquare t P hP).toRepresentation
      (spechtRep v).dual where
  toLinearMap := F.toLinearMap.flip
  isIntertwining' g := by
    apply LinearMap.ext
    intro y
    ext x
    change F x ((balanceProjectedSquare t P hP).toRepresentation g y) =
      F (spechtRep v g⁻¹ x) y
    have he := congrArg
      (fun l : Module.Dual ℂ (balanceProjectedSquare t P hP).toSubmodule => l y)
      (F.map_action g⁻¹ x)
    change F (spechtRep v g⁻¹ x) y =
      F x ((balanceProjectedSquare t P hP).toRepresentation ((g⁻¹)⁻¹) y) at he
    simpa only [inv_inv] using he.symm

/-- Forward support in the filtered full square, assuming a local pair-cyclic
support input. -/
theorem balanceProjected_support_of_pair {n : ℕ} {mu nu : YoungDiagram}
    (t s u : Tableau n mu) (v : Tableau n nu)
    (P : (Fin n → Fin (mu.colLen 0 * mu.colLen 0)) → Prop)
    (hP : ∀ (g : Equiv.Perm (Fin n)) w, P (w ∘ g) ↔ P w)
    (hp : P (mergeWords (rowWord s) (rowWord u)))
    (f : Representation.IntertwiningMap (spechtRep v)
      (cyclic (wordRep n (mu.transpose.colLen 0 * mu.transpose.colLen 0))
        (wordTensor _ _ _ (polytabloid (transposeTableau s) ⊗ₜ[ℂ]
          polytabloid (transposeTableau u)))).toRepresentation)
    (hf : Function.Injective f) :
    ∃ J : Representation.IntertwiningMap (spechtRep v)
      (balanceProjectedSquare t P hP).toRepresentation, Function.Injective J := by
  letI : NeZero (Nat.card (Equiv.Perm (Fin n)) : ℂ) :=
    ⟨by exact_mod_cast (Nat.card_pos : 0 < Nat.card (Equiv.Perm (Fin n))).ne'⟩
  have hm := balanceProjected_pair_cyclic_le_range t s u P hP hp (mem_cyclic _ _)
  obtain ⟨lam,hlam⟩ := hm
  have hsource : ∃ j : Representation.IntertwiningMap (spechtRep v)
      (cyclicSubrepresentation (wordRep n (mu.transpose.colLen 0 * mu.transpose.colLen 0))
        (balanceProjectedDualMap t P hP lam)).toRepresentation, Function.Injective j := by
    have hv : balanceProjectedDualMap t P hP lam =
        wordTensor _ _ _ (polytabloid (transposeTableau s) ⊗ₜ[ℂ]
          polytabloid (transposeTableau u)) := hlam
    have he : cyclic (wordRep n (mu.transpose.colLen 0 * mu.transpose.colLen 0))
        (wordTensor _ _ _ (polytabloid (transposeTableau s) ⊗ₜ[ℂ]
          polytabloid (transposeTableau u))) =
        cyclicSubrepresentation (wordRep n (mu.transpose.colLen 0 * mu.transpose.colLen 0))
          (balanceProjectedDualMap t P hP lam) := by
      apply SetLike.ext
      intro x
      change x ∈ cyclicSpan (wordRep n (mu.transpose.colLen 0 * mu.transpose.colLen 0))
          (wordTensor _ _ _ (polytabloid (transposeTableau s) ⊗ₜ[ℂ]
            polytabloid (transposeTableau u))) ↔
        x ∈ cyclicSpan (wordRep n (mu.transpose.colLen 0 * mu.transpose.colLen 0))
          (balanceProjectedDualMap t P hP lam)
      rw [congrArg (cyclicSpan (wordRep n (mu.transpose.colLen 0 * mu.transpose.colLen 0))) hv.symm]
    let E := equalSubrepresentationMap _ _ he
    exact ⟨E.comp f,(equalSubrepresentationMap_bijective _ _ he).1.comp hf⟩
  obtain ⟨j,hj⟩ := hsource
  obtain ⟨i,hi,_⟩ := cyclicImage_embedding_lift (balanceProjectedDualMap t P hP) lam j hj
  let inc : Representation.IntertwiningMap
      (cyclicSubrepresentation (balanceProjectedSquare t P hP).toRepresentation.dual lam).toRepresentation
      (balanceProjectedSquare t P hP).toRepresentation.dual :=
    { toLinearMap := Submodule.subtype _
      isIntertwining' _ := LinearMap.ext (fun _ => rfl) }
  have hinc : Function.Injective inc := fun _ _ hh => Subtype.ext hh
  let F := inc.comp i
  have hF : Function.Injective F := hinc.comp hi
  let G := (coordinateSelfDualInverse v).comp (projectedSpechtFlip t v P hP F)
  have hG : G ≠ 0 := by
    intro hzero
    have hzF : F = 0 := by
      ext x y
      have hy := congrArg (fun q => q y) hzero
      have hz : projectedSpechtFlip t v P hP F y = 0 := by
        apply (spechtSelfDualLinear v).symm.injective
        change (spechtSelfDualLinear v).symm (projectedSpechtFlip t v P hP F y) =
          (spechtSelfDualLinear v).symm 0
        change (spechtSelfDualLinear v).symm (projectedSpechtFlip t v P hP F y) = 0 at hy
        exact hy.trans ((spechtSelfDualLinear v).symm.toLinearMap.map_zero).symm
      exact congrArg (fun l : Module.Dual ℂ (Specht v) => l x) hz
    have hpzero : (⟨polytabloid v,mem_cyclic _ _⟩ : Specht v) = 0 := by
      apply hF
      rw [hzF]
      rfl
    exact polytabloid_ne_zero v (congrArg Subtype.val hpzero)
  letI : Representation.IsIrreducible (spechtRep v) := specht_irreducible v
  have hsurj : Function.Surjective G :=
    intertwiner_surjective_of_irreducible G hG
  obtain ⟨J,hJ,_⟩ := equivariant_injective_lift G hsurj
    (Representation.IntertwiningMap.id (spechtRep v)) (fun _ _ hh => hh)
  exact ⟨J,hJ⟩

end
