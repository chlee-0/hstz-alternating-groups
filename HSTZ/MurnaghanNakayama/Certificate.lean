import HSTZ.MurnaghanNakayama.Compute

/-!
# Closed-world recurrence certificates

Certificates store integer values, which the checker recomputes. The head of a
list may depend only on its already checked tail, and a missing dependency causes
rejection. Every recurrence summand is regenerated by `moves`, so a certificate
cannot omit a summand. Duplicate keys are harmless: every row that passes the
check has the same mathematically determined value at its key.

Soundness below is relative to the executable recurrence `mn`;
`HSTZ.TauCetiFinite.Agreement` relates `mn` to Specht characters. The program that
produces certificates is not trusted: soundness depends only on the checker, which
uses simple linear lookup.
-/
namespace HSTZ.MurnaghanNakayama

structure Entry where
  shape : Shape
  cycles : List ℕ
  value : ℤ
  deriving DecidableEq, Repr

abbrev Certificate := List Entry

def lookup : Certificate → Shape → List ℕ → Option ℤ
  | [], _, _ => none
  | e :: es, lam, rho =>
      if e.shape = lam ∧ e.cycles = rho then some e.value else lookup es lam rho

def CacheSound (cache : Certificate) : Prop :=
  ∀ e ∈ cache, e.value = mn e.shape e.cycles

def cachedSum (cache : Certificate) (rho : List ℕ) : List Move → Option ℤ
  | [] => some 0
  | m :: ms =>
      match lookup cache m.shape rho, cachedSum cache rho ms with
      | some a, some b => some (legSign m.leg * a + b)
      | _, _ => none

def step (cache : Certificate) (lam : Shape) : List ℕ → Option ℤ
  | [] => some (baseValue lam)
  | r :: rho => cachedSum cache rho (moves lam r)

def checkEntry (cache : Certificate) (e : Entry) : Bool :=
  decide (step cache e.shape e.cycles = some e.value)

/-- Reverse topological order: dependencies are in the tail. -/
def verify : Certificate → Bool
  | [] => true
  | e :: es => verify es && checkEntry es e

/-- An empty or unrelated certificate cannot certify a requested value. -/
def checkValue (cert : Certificate) (lam rho : List ℕ) (v : ℤ) : Bool :=
  verify cert && decide (lookup cert lam rho = some v)

lemma lookup_sound {cache : Certificate} : CacheSound cache →
    ∀ {lam rho : List ℕ} {v : ℤ}, lookup cache lam rho = some v →
      v = mn lam rho := by
  induction cache with
  | nil => intro hc lam rho v hv; simp [lookup] at hv
  | cons e es ih =>
      intro hc lam rho v hv
      by_cases he : e.shape = lam ∧ e.cycles = rho
      · have heval : e.value = v := by simpa [lookup, he] using hv
        calc
          v = e.value := heval.symm
          _ = mn e.shape e.cycles := hc e (by simp)
          _ = mn lam rho := by rw [he.1, he.2]
      · have ht : CacheSound es := by
          intro x hx
          exact hc x (by simp [hx])
        exact ih ht (by simpa [lookup, he] using hv)

lemma cachedSum_sound {cache : Certificate} (hc : CacheSound cache)
    (rho : List ℕ) (ms : List Move) : ∀ {v : ℤ},
    cachedSum cache rho ms = some v →
      v = weightedSum (fun mu => mn mu rho) ms := by
  induction ms with
  | nil => intro v hv; simpa [cachedSum, weightedSum] using hv.symm
  | cons m ms ih =>
      intro v hv
      cases ha : lookup cache m.shape rho with
      | none => simp [cachedSum, ha] at hv
      | some a =>
          cases hb : cachedSum cache rho ms with
          | none => simp [cachedSum, ha, hb] at hv
          | some b =>
              have he : legSign m.leg * a + b = v := by
                simpa [cachedSum, ha, hb] using hv
              calc
                v = legSign m.leg * a + b := he.symm
                _ = legSign m.leg * mn m.shape rho +
                    weightedSum (fun mu => mn mu rho) ms := by
                      rw [lookup_sound hc ha, ih hb]
                _ = weightedSum (fun mu => mn mu rho) (m :: ms) := rfl

lemma checkEntry_sound {cache : Certificate} (hc : CacheSound cache)
    (e : Entry) (he : checkEntry cache e = true) :
    e.value = mn e.shape e.cycles := by
  have hs : step cache e.shape e.cycles = some e.value := of_decide_eq_true he
  cases hr : e.cycles with
  | nil => simpa [step, hr, mn, mnAux] using hs.symm
  | cons r rho =>
      have hv : cachedSum cache rho (moves e.shape r) = some e.value := by
        simpa [step, hr] using hs
      rw [mn_cons]
      exact cachedSum_sound hc rho (moves e.shape r) hv

theorem verify_sound (cert : Certificate) : verify cert = true →
    CacheSound cert := by
  induction cert with
  | nil => intro h e he; simp at he
  | cons e es ih =>
      intro h
      have hh : verify es = true ∧ checkEntry es e = true := by
        simpa only [verify, Bool.and_eq_true] using h
      have ht := ih hh.1
      intro x hx
      rcases List.mem_cons.mp hx with hx | hx
      · subst x
        exact checkEntry_sound ht e hh.2
      · exact ht x hx

theorem checkValue_sound (cert : Certificate) (lam rho : List ℕ) (v : ℤ)
    (h : checkValue cert lam rho v = true) : mn lam rho = v := by
  have hh : verify cert = true ∧ lookup cert lam rho = some v := by
    simpa only [checkValue, Bool.and_eq_true, decide_eq_true_eq] using h
  exact (lookup_sound (verify_sound cert hh.1) hh.2).symm

end HSTZ.MurnaghanNakayama

